# GitHub Personal Access Token with 'repo' scope
GITHUB_TOKEN=your_github_token_here

# Default CLI agent: "codex", "claude", "cursor", "antigravity", etc.
DEFAULT_AGENT=codex

# Repositories to monitor (comma-separated owner/repo format)
MONITORED_REPOS=owner/repo-one,owner/repo-two

# Local repository folder path mappings (Format: REPO_PATH_<SANITIZED_REPO_NAME>)
# Replace hyphen/slash with underscore, uppercase (e.g. owner/repo-one -> REPO_PATH_OWNER_REPO_ONE)
REPO_PATH_OWNER_REPO_ONE=/Users/username/Projects/repo-one
REPO_PATH_OWNER_REPO_TWO=/Users/username/Projects/repo-two
